# Netpro Sourcing — email integration
# Copy this file to ".env" for local development (`vercel dev`), or configure
# the same names in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values to GitHub.

# Which sending channel the /api/* functions use: "resend" (default) or "qq".
EMAIL_PROVIDER=resend

# ---------------------------------------------------------------------------
# Shared (required for both providers)
# ---------------------------------------------------------------------------

# Internal inbox that receives Contact / Quote / Purchase enquiries.
NETPRO_ENQUIRY_EMAIL=

# Reply-To on the automatic customer confirmation emails,
# so customer replies go straight to Netpro.
NETPRO_REPLY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Resend (production) — used when EMAIL_PROVIDER=resend
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Verified sender, e.g. Netpro Sourcing <notifications@yourdomain.com>
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# QQ Mail SMTP (temporary demo channel) — used when EMAIL_PROVIDER=qq
# ---------------------------------------------------------------------------
# The QQ SMTP authorization code is NOT the QQ account password; generate it
# in QQ Mail → Settings → Account → POP3/SMTP service.
# The sender is always the authenticated QQ mailbox itself
# (From: Netpro Sourcing <QQ_SMTP_USER>) — no spoofed From addresses.

QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_SECURE=true
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=

# ---------------------------------------------------------------------------
# Next.js / Sanity experiment
# ---------------------------------------------------------------------------

# Public project settings used by the website and Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=5mntophk
NEXT_PUBLIC_SANITY_DATASET=production
# Optional preview metadata origin. Vercel deployments default to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Server-only, read-only Sanity token used for draft content previews.
# Never prefix this value with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only token with write access, used only by the explicit seed command.
SANITY_API_WRITE_TOKEN=
