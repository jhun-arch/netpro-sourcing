# Netpro Sourcing — Resend email integration
# Copy this file to ".env" for local development (`vercel dev`), or configure
# the same names in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values to GitHub.

# Required. Server-side only, used by the /api/* functions.
RESEND_API_KEY=

# Required. Verified sender, e.g. Netpro Sourcing <notifications@yourdomain.com>
RESEND_FROM_EMAIL=

# Required. Internal inbox that receives Contact / Quote / Purchase enquiries.
NETPRO_ENQUIRY_EMAIL=

# Required. Reply-To on the automatic customer confirmation emails,
# so customer replies go straight to Netpro.
NETPRO_REPLY_TO_EMAIL=
